#!/usr/bin/env bash
set -euo pipefail

# Run from the script's own directory so the alias works from any CWD.
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

# TODO(install-nix): install Nix if not present. Currently the script
# assumes `nix` is on PATH.

# A freshly installed Nix ships with flakes off, so the first `./dlsys init`
# on a new machine would die with "experimental Nix feature 'nix-command' is
# disabled" before it could write the nix.conf that enables them. Enable them
# for every nix invocation this script makes instead of making the user edit
# nix.conf by hand. Appended last so it wins over any inherited NIX_CONFIG;
# NixOS hosts already enable both via nix.settings.experimental-features.
if [[ -n "${NIX_CONFIG:-}" ]]; then
  NIX_CONFIG="$NIX_CONFIG"$'\n'"extra-experimental-features = nix-command flakes"
else
  NIX_CONFIG="extra-experimental-features = nix-command flakes"
fi
export NIX_CONFIG

usage() {
  cat <<'EOF'
Usage:
  dlsys init                       Register this machine (interactive)
  dlsys upgrade [target] [--update]
      target = auto   (default) build both layers, switch only the ones
                      whose store path differs from what is live
             = hm     home-manager switch only                (alias: hms)
             = nixos  nixos-rebuild switch only               (alias: nrs)
             = all    both layers, unconditionally            (alias: alls)
      auto never asks for sudo when the system layer is unchanged. Naming a
      target explicitly always switches it, even if nothing differs.
      The aliases are the intended entry point for these three; they are
      defined in modules/zsh.nix under shellAliases. dlsys itself is on PATH
      via ~/.local/bin (symlinked by modules/base.nix), so it runs from any
      directory.
      --update also refreshes flake inputs first (excludes nixpkgs-ollama,
                which is pinned to avoid the CUDA rebuild; bump manually with
                'nix flake lock --update-input nixpkgs-ollama')

  dlsys rollout [--order h1,h2,...] [--update]
      Run 'upgrade auto' on every managed machine, one at a time, against
      the same commit -- a host whose system layer is unchanged is never
      asked for a sudo password. Requires a clean working tree that matches its
      upstream branch; remote hosts 'git pull --ff-only' first.
      Local tool repos that ship through this flake (dl-herd) are checked
      too: a dirty one aborts the rollout, an unpushed one prompts to push
      and then bumps that input in flake.lock -- otherwise this host builds
      your working copy while every remote host builds the older pin.
      --order  explicit host order (may be a subset); default: suspense,dance
      --update refresh flake inputs once locally, commit and push, then
               upgrade every host against that lock
      console is not covered -- it is unreachable from the tailnet and
      is upgraded by hand until it joins.
EOF
}

require_nix() {
  if ! command -v nix >/dev/null; then
    echo "nix is not installed. Install Nix first (see README) and re-run." >&2
    exit 1
  fi
}

require_flake_root() {
  if [[ ! -f flake.nix ]]; then
    echo "Run this from the home-manager repo root." >&2
    exit 1
  fi
}

# Hosts 'dlsys rollout' manages, in default upgrade order. suspense first:
# it runs the snapcast/music server that dance's snapclient connects to.
DEFAULT_ORDER=(suspense dance console)

# host -> ssh destination. Unknown hosts return non-zero.
ssh_target() {
  case "$1" in
    suspense) echo "dlangevi@suspense" ;;
    dance)    echo "dance@dance" ;;
    console)    echo "console@console" ;;
    *) return 1 ;;
  esac
}

get_hostname() {
  local h
  h=$(hostname)
  if [[ "$h" == *\"* || "$h" == *\\* || "$h" == *$'\n'* ]]; then
    echo "Hostname \"$h\" contains invalid characters (quote, backslash, or newline)." >&2
    exit 1
  fi
  printf '%s' "$h"
}

machine_registered() {
  local host=$1 result
  result=$(nix eval --impure --json --file machines.nix \
    --apply "x: builtins.hasAttr \"$host\" x") || return 1
  [[ "$result" == "true" ]]
}

machine_features() {
  local host=$1
  nix eval --impure --raw --file machines.nix \
    --apply "x: builtins.concatStringsSep \" \" x.\"$host\""
}

feature_catalog() {
  nix eval --impure --raw --file features.nix \
    --apply 'f:
      let attrs = f { dldev = null; };
      in builtins.concatStringsSep "\n" (builtins.attrNames attrs)'
}

# Invoke home-manager via `nix run` so the script works on a fresh machine
# that only has `nix` installed, and stays pinned to the version tracked
# in flake.lock even when a stale binary is on PATH.
hm() {
  nix run --impure ".#home-manager" -- "$@"
}

# Update every root input except nixpkgs-ollama. Ollama's derivation triggers
# a multi-hour CUDA rebuild for sm_61 (Pascal / GTX 1060 on suspense); pinning
# its input means routine updates hit the store cache. Bump ollama manually
# with:
#   nix flake lock --update-input nixpkgs-ollama
update_inputs() {
  local inputs
  inputs=$(nix eval --raw --file flake.nix --apply \
    'f: builtins.concatStringsSep " "
          (builtins.filter (n: n != "nixpkgs-ollama")
            (builtins.attrNames f.inputs))')
  # shellcheck disable=SC2086
  nix flake update $inputs
}

do_init() {
  require_nix
  require_flake_root
  local host
  host=$(get_hostname)

  if machine_registered "$host"; then
    local existing
    existing=$(machine_features "$host")
    echo "$host is already registered as [ $existing ]." >&2
    echo "Use 'dlsys upgrade' to apply changes, or edit machines.nix to modify the feature list." >&2
    exit 1
  fi

  local features=("base")
  local feat answer
  # `|| [[ -n "$feat" ]]` handles feature_catalog's final line lacking a
  # trailing newline (nix eval --raw emits the string as-is).
  while IFS= read -r feat || [[ -n "$feat" ]]; do
    [[ -z "$feat" ]] && continue
    [[ "$feat" == "base" ]] && continue
    read -r -p "Include $feat? [y/N]: " answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      features+=("$feat")
    fi
  done < <(feature_catalog)

  local features_nix=""
  local f
  for f in "${features[@]}"; do
    features_nix+="\"$f\" "
  done

  local new_content
  new_content=$(nix eval --impure --raw --expr "
    import ./scripts/machines-write.nix {
      machines = import ./machines.nix;
      host = \"$host\";
      features = [ $features_nix];
    }
  ")
  printf '%s' "$new_content" > machines.nix

  local feature_list="${features[*]}"
  git add machines.nix
  git commit -m "chore: register $host with features $feature_list"

  if ! hm switch --impure --flake ".#$host"; then
    echo "Registration committed but switch failed. Fix the issue and run './dlsys upgrade'," >&2
    echo "or undo with 'git reset --soft HEAD~1'." >&2
    exit 1
  fi
  echo "Registered. Run 'git push' when ready."
}

# What is live right now, per layer. Empty when the layer has never been
# activated on this host (fresh machine, or home-manager run for the first
# time), which callers treat as "differs".
current_hm() {
  readlink -f "$HOME/.local/state/home-manager/gcroots/current-home" 2>/dev/null || true
}

current_nixos() {
  readlink -f /run/current-system 2>/dev/null || true
}

# Build a layer without creating a ./result symlink and print its store path.
# Progress goes to stderr so the caller can capture the path from stdout.
build_out() {
  nix build --impure --no-link --print-out-paths "$1"
}

# Which layers actually differ from what is live. Answering this by building
# both and comparing store paths is exact: it catches a flake.lock bump that
# only moves one layer, and skips a nixos/ edit that evaluates to the system
# already running. Deciding from changed file paths instead cannot do either.
# The build is not wasted -- the switch that follows reuses it from the store.
detect_targets() {
  local host=$1 is_nixos=$2
  local out=""
  local built

  echo "==> checking home-manager layer" >&2
  built=$(build_out ".#homeConfigurations.\"$host\".activationPackage")
  if [[ "$built" != "$(current_hm)" ]]; then
    out+="hm "
  fi

  if [[ $is_nixos -eq 1 ]]; then
    echo "==> checking nixos layer" >&2
    built=$(build_out ".#nixosConfigurations.\"$host\".config.system.build.toplevel")
    if [[ "$built" != "$(current_nixos)" ]]; then
      out+="nixos "
    fi
  fi

  printf '%s' "$out"
}

do_upgrade() {
  local do_update=0
  local target="auto"
  local arg
  for arg in "$@"; do
    case "$arg" in
      --update) do_update=1 ;;
      hm|nixos|all|auto) target="$arg" ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
  done
  require_nix
  require_flake_root
  local host
  host=$(get_hostname)
  if ! machine_registered "$host"; then
    echo "$host is not registered. Run 'dlsys init' first." >&2
    exit 1
  fi
  if [[ $do_update -eq 1 ]]; then
    update_inputs
  fi

  local is_nixos=0
  if [[ -f /etc/nixos/configuration.nix ]] || [[ -e /run/current-system/nixos-version ]]; then
    is_nixos=1
  fi

  # 'auto' resolves to the layers that actually differ. An explicit target
  # stays a command, not a suggestion: 'dlsys upgrade nixos' re-switches even
  # when the built system matches, which is what you want when activation
  # itself is the point (a unit to restart, a stale generation to re-link).
  # Plain if blocks rather than `[[ ... ]] && var=1`: under `set -e` a test
  # that lands false makes the whole line return 1 and kills the script.
  local do_hm=0 do_nixos=0
  if [[ "$target" == "auto" ]]; then
    local layers
    layers=$(detect_targets "$host" "$is_nixos")
    if [[ -z "$layers" ]]; then
      echo "Already up to date; nothing to switch."
      return 0
    fi
    if [[ "$layers" == *hm* ]]; then
      do_hm=1
    fi
    if [[ "$layers" == *nixos* ]]; then
      do_nixos=1
    fi
    echo "==> changed: ${layers% }"
  else
    if [[ "$target" == "hm" || "$target" == "all" ]]; then
      do_hm=1
    fi
    if [[ "$target" == "nixos" || "$target" == "all" ]]; then
      do_nixos=1
    fi
  fi

  if [[ $do_nixos -eq 1 ]]; then
    if [[ $is_nixos -eq 0 ]]; then
      echo "This host is not NixOS — 'nixos' target is unavailable." >&2
      exit 1
    fi
    echo "==> nixos-rebuild switch --flake .#$host"
    sudo nixos-rebuild switch --flake ".#$host" --impure
  fi

  if [[ $do_hm -eq 1 ]]; then
    echo "==> home-manager switch --flake .#$host"
    hm switch --impure --flake ".#$host"
  fi
}

require_clean_repo() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "Working tree has uncommitted changes. Commit or stash them first --" >&2
    echo "remote hosts upgrade from the pushed commit, not from this checkout." >&2
    exit 1
  fi
  git fetch --quiet origin
  local upstream head
  if ! upstream=$(git rev-parse --verify --quiet '@{u}'); then
    echo "Current branch has no upstream. Push it first." >&2
    exit 1
  fi
  head=$(git rev-parse HEAD)
  if [[ "$head" != "$upstream" ]]; then
    echo "Local branch differs from its upstream. Push (or pull) first so every" >&2
    echo "host upgrades the same commit." >&2
    exit 1
  fi
}

# Local tool repos whose code ships through this flake: "<flake input>=<path>".
# Their working copy is what THIS host builds (see flake.nix's herdLocal
# preference), but every remote host builds the revision pinned in flake.lock.
# A rollout from a dirty or unpushed tool repo therefore deploys one thing here
# and a different, older thing everywhere else -- silently. So rollout checks
# them first.
TOOL_REPOS=("dl-herd=/home/dlangevi/auto/dl-herd")

# Refuse to roll out from a dirty tool repo; offer to push an unpushed one.
# A push here only changes what origin has -- flake.lock still pins the old
# revision -- so a successful push is followed by bumping that input, which is
# what actually gets the new code onto the remote hosts.
check_tool_repos() {
  local entry name path upstream head answer
  for entry in "${TOOL_REPOS[@]}"; do
    name=${entry%%=*}
    path=${entry#*=}
    [[ -d "$path/.git" ]] || continue

    echo "==> checking $name ($path)"

    if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
      echo "$name has uncommitted changes. Remote hosts build the pushed" >&2
      echo "revision, so commit and push them before rolling out:" >&2
      echo "  git -C $path status" >&2
      exit 1
    fi

    git -C "$path" fetch --quiet origin
    if ! upstream=$(git -C "$path" rev-parse --verify --quiet '@{u}'); then
      echo "$name's branch has no upstream. Push it first." >&2
      exit 1
    fi
    head=$(git -C "$path" rev-parse HEAD)
    if [[ "$head" == "$upstream" ]]; then
      continue
    fi

    if git -C "$path" merge-base --is-ancestor "$upstream" "$head"; then
      echo "$name is ahead of origin by $(git -C "$path" rev-list --count "$upstream..$head") commit(s)."
      read -r -p "Push them now? [y/N]: " answer </dev/tty
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "Declined. Remote hosts would get the older pinned revision." >&2
        exit 1
      fi
      git -C "$path" push
    else
      echo "$name has diverged from its upstream (behind, or rebased)." >&2
      echo "Reconcile it by hand before rolling out." >&2
      exit 1
    fi

    # The push moved origin; teach flake.lock about it, or the rollout still
    # deploys the revision it pinned before.
    echo "==> nix flake update $name"
    nix flake update "$name"
    if git diff --quiet -- flake.lock; then
      echo "flake.lock already pinned that revision."
    else
      git commit -q flake.lock -m "chore: bump $name"
      git push -q
      echo "flake.lock bumped to the new $name revision, committed and pushed."
    fi
  done
}

do_rollout() {
  local do_update=0
  local order=""
  local arg
  while [[ $# -gt 0 ]]; do
    arg=$1
    case "$arg" in
      --update) do_update=1 ;;
      --order)
        shift
        order=${1:-}
        if [[ -z "$order" ]]; then
          usage >&2
          exit 2
        fi
        ;;
      --order=*) order=${arg#--order=} ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    shift
  done

  require_nix
  require_flake_root

  local hosts=()
  if [[ -n "$order" ]]; then
    IFS=',' read -r -a hosts <<< "$order"
  else
    hosts=("${DEFAULT_ORDER[@]}")
  fi

  local host
  for host in "${hosts[@]}"; do
    if [[ -z "$host" ]]; then
      echo "Empty host in --order list." >&2
      exit 2
    fi
    if ! machine_registered "$host"; then
      echo "$host is not registered in machines.nix." >&2
      exit 1
    fi
    if ! ssh_target "$host" >/dev/null; then
      echo "$host has no ssh target in dlsys's host map (console is" >&2
      echo "deliberately excluded). Add one before including it." >&2
      exit 1
    fi
  done

  require_clean_repo
  check_tool_repos

  if [[ $do_update -eq 1 ]]; then
    echo "==> nix flake update"
    update_inputs
    if git diff --quiet -- flake.lock; then
      echo "flake.lock unchanged; nothing to push."
    else
      git commit -q flake.lock -m "chore: update flake inputs"
      git push -q
      echo "flake.lock updated, committed and pushed."
    fi
  fi

  local self total i remaining
  self=$(get_hostname)
  total=${#hosts[@]}
  for i in "${!hosts[@]}"; do
    host=${hosts[$i]}
    echo
    echo "==> [$((i + 1))/$total] $host"
    if [[ "$host" == "$self" ]]; then
      if ! do_upgrade auto; then
        remaining=("${hosts[@]:i+1}")
        echo "FAILED on $host." >&2
        if [[ ${#remaining[@]} -gt 0 ]]; then
          echo "Not attempted: ${remaining[*]}" >&2
        fi
        exit 1
      fi
    else
      if ! ssh -t "$(ssh_target "$host")" \
        'set -e; cd ~/.config/home-manager && git pull --ff-only && ./dlsys upgrade auto'; then
        remaining=("${hosts[@]:i+1}")
        echo "FAILED on $host." >&2
        if [[ ${#remaining[@]} -gt 0 ]]; then
          echo "Not attempted: ${remaining[*]}" >&2
        fi
        exit 1
      fi
    fi
  done

  echo
  echo "Upgraded: ${hosts[*]}"
}

case "${1:-}" in
  init)
    shift
    do_init "$@"
    ;;
  upgrade)
    shift
    do_upgrade "$@"
    ;;
  rollout)
    shift
    do_rollout "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

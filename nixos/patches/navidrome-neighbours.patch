diff --color -ruN '--exclude=.git' a/ui/src/neighbour/NeighbourList.jsx b/ui/src/neighbour/NeighbourList.jsx
--- a/ui/src/neighbour/NeighbourList.jsx	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/src/neighbour/NeighbourList.jsx	2026-09-08 16:22:46.842676071 -0700
@@ -0,0 +1,148 @@
+import React, { useEffect, useState } from 'react'
+import { Datagrid, List, useDataProvider } from 'react-admin'
+import { Link } from 'react-router-dom'
+import { withWidth } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useAlbumsPerPage } from '../common'
+
+const useStyles = makeStyles({
+  link: { textDecoration: 'none', color: 'inherit' },
+})
+
+// Filters on the tag VALUE. tagIDFilter walks json_tree and compares every
+// leaf, so an id would match too, but the value is what an AlbumDetails-style
+// link carries.
+//
+// The filter is embedded raw, as AlbumDetails does for genre chips. Running
+// it through encodeURIComponent first meant react-router encoded the target a
+// second time, so the colon arrived as %253A and the filter was not valid
+// JSON -- which looked like the separator being at fault when it was the
+// encoding.
+const useAlbumsOfNeighbour = (width) => {
+  const [perPage] = useAlbumsPerPage(width)
+
+  return (record) =>
+    `/album?filter={"neighbour":${JSON.stringify([record.tagValue])}}` +
+    `&order=ASC&sort=name&perPage=${perPage}`
+}
+
+const NeighbourNameField = withWidth()(({ width, record }) => {
+  const classes = useStyles()
+  const albumsOf = useAlbumsOfNeighbour(width)
+  if (!record) return null
+  return (
+    <Link to={albumsOf(record)} className={classes.link}>
+      {record.tagValue}
+    </Link>
+  )
+})
+
+// Navidrome maintains album_count for genre tags only: UpdateCounts in
+// tag_repository.go hardcodes json_tree(album.tags, '$.genre'), so every
+// other tag -- neighbour, and equally recordlabel, grouping and mood --
+// stays at zero, and model.Tag declares AlbumCount `json:"albumCount,omitempty"`
+// so that zero never even reaches the client. The counts are tallied here
+// instead, from one pass over the albums, which carry their tags in the API
+// (Album.Tags is `json:"tags"`).
+//
+// Deliberately NOT useGetList. That hook returns nothing from the response
+// itself: it selects ids back out of redux at
+// resources[album].list.cachedRequests[requestSignature], where
+// requestSignature is JSON.stringify of the pagination/sort/filter as passed
+// in, while the reducer stores the entry under JSON.stringify of the request
+// payload as it stands when the response lands. wrapperDataProvider mutates
+// that same filter object in between -- params.filter.missing and
+// params.filter.library_id are assigned in place -- so the two keys never
+// match, ids comes back null, and data is {} however well the request went.
+//
+// Reading the promise sidesteps the store, the signature and the mutation.
+const useNeighbourCounts = () => {
+  const dataProvider = useDataProvider()
+  const [state, setState] = useState({ counts: {}, loaded: false, error: null })
+
+  useEffect(() => {
+    let cancelled = false
+
+    dataProvider
+      // perPage 0 is this codebase's idiom for "all of them", as
+      // AlbumFilter's reference inputs use. A fresh filter object each call,
+      // since the provider writes into it.
+      .getList('album', {
+        pagination: { page: 1, perPage: 0 },
+        sort: { field: 'name', order: 'ASC' },
+        filter: {},
+      })
+      .then(({ data }) => {
+        if (cancelled) return
+        const tally = {}
+        ;(data || []).forEach((album) => {
+          const names = album?.tags?.neighbour || []
+          names.forEach((name) => {
+            tally[name] = (tally[name] || 0) + 1
+          })
+        })
+        setState({ counts: tally, loaded: true, error: null })
+      })
+      .catch((error) => {
+        if (!cancelled) setState({ counts: {}, loaded: false, error })
+      })
+
+    return () => {
+      cancelled = true
+    }
+  }, [dataProvider])
+
+  return state
+}
+
+const AlbumCountField = ({ record, counts, loaded, error }) => {
+  if (!record) return null
+  if (error) return <span>-</span>
+  if (!loaded) return <span>…</span>
+  return <span>{counts[record.tagValue] || 0}</span>
+}
+
+// Right-aligned like the NumberField it replaces, and never sortable:
+// sorting is done by the server, and album_count is zero for every tag but
+// genre, so the header offered an ordering it could not deliver. Datagrid
+// reads both off the child's props.
+AlbumCountField.defaultProps = { textAlign: 'right', sortable: false }
+
+// Reads the `tag` resource rather than a `neighbour` one: there is no
+// /api/neighbour, and none is needed -- a neighbour is just a value of the
+// `neighbour` tag. Narrowing by tag_name is how AlbumFilter reads its own
+// recordlabel and grouping values.
+const NeighbourList = (props) => {
+  const { counts, loaded, error } = useNeighbourCounts()
+
+  return (
+    <List
+      {...props}
+      resource="tag"
+      basePath="/neighbour"
+      filter={{ tag_name: 'neighbour' }}
+      filters={null}
+      exporter={false}
+      bulkActionButtons={false}
+      sort={{ field: 'name', order: 'ASC' }}
+      perPage={200}
+      pagination={null}
+    >
+      <Datagrid>
+        <NeighbourNameField
+          source="tagValue"
+          label="resources.neighbour.fields.name"
+        />
+        <AlbumCountField
+          source="albumCount"
+          label="resources.neighbour.fields.albumCount"
+          counts={counts}
+          loaded={loaded}
+          error={error}
+        />
+      </Datagrid>
+    </List>
+  )
+}
+
+export default NeighbourList

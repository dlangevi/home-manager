+  list: NeighbourList,
+  icon: (
+    <DynamicMenuIcon
+      path={'neighbour'}
+      icon={PeopleOutlinedIcon}
+      activeIcon={PeopleIcon}
+    />
+  ),
+}
diff --color -ruN '--exclude=.git' a/ui/src/neighbour/NeighbourList.jsx b/ui/src/neighbour/NeighbourList.jsx
--- a/ui/src/neighbour/NeighbourList.jsx	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/src/neighbour/NeighbourList.jsx	2026-09-08 12:53:15.483987202 -0700
@@ -0,0 +1,124 @@
+import React, { useMemo } from 'react'
+import { Datagrid, List, useGetList } from 'react-admin'
+import { Link } from 'react-router-dom'
+import { withWidth } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useAlbumsPerPage } from '../common'
+
+const useStyles = makeStyles({
+  link: { textDecoration: 'none', color: 'inherit' },
+})
+
+// Filters on the tag VALUE, not the tag id. Album.SetTags stores
+// GroupByFrequency's output in the album's `tags` column, and that maps each
+// tag name to its values -- so despite its name, tagIDFilter compares against
+// "David L", and a tag id would never match.
+//
+// The filter is embedded raw, as AlbumDetails does for genre chips. Running
+// it through encodeURIComponent first meant react-router encoded it a second
+// time and the separator arrived as %25-escaped, leaving a filter the album
+// list could not read.
+const useAlbumsOfNeighbour = (width) => {
+  const [perPage] = useAlbumsPerPage(width)
+
+  return (record) =>
+    `/album?filter={"neighbour"=${JSON.stringify([record.tagValue])}}` +
+    `&order=ASC&sort=name&perPage=${perPage}`
+}
+
+const NeighbourNameField = withWidth()(({ width, record }) => {
+  const classes = useStyles()
+  const albumsOf = useAlbumsOfNeighbour(width)
+  if (!record) return null
+  return (
+    <Link to={albumsOf(record)} className={classes.link}>
+      {record.tagValue}
+    </Link>
+  )
+})
+
+// Navidrome maintains album_count for genre tags only: UpdateCounts in
+// tag_repository.go hardcodes json_tree(album.tags, '$.genre'), so every
+// other tag -- neighbour, and equally recordlabel, grouping and mood --
+// stays at zero, and model.Tag declares AlbumCount `json:"albumCount,omitempty"`
+// so that zero never even reaches the client.
+//
+// The counts are therefore tallied here, from one pass over the albums.
+// Albums carry their tags in the API (Album.Tags is `json:"tags"`), which is
+// how AlbumTableView reads a mood and AlbumInfo a record label, so the
+// neighbour is right there on each record. perPage 0 is this codebase's
+// idiom for "all of them", as AlbumFilter's reference inputs use.
+//
+// One request for the whole page rather than one per row: asking for a
+// single album per neighbour and reading the reported total did not work.
+const useNeighbourCounts = () => {
+  const { data, loaded, error } = useGetList(
+    'album',
+    { page: 1, perPage: 0 },
+    { field: 'name', order: 'ASC' },
+    {},
+  )
+
+  const counts = useMemo(() => {
+    const tally = {}
+    Object.values(data || {}).forEach((album) => {
+      const names = album?.tags?.neighbour || []
+      names.forEach((name) => {
+        tally[name] = (tally[name] || 0) + 1
+      })
+    })
+    return tally
+  }, [data])
+
+  return { counts, loaded, error }
+}
+
+const AlbumCountField = ({ record, counts, loaded, error }) => {
+  if (!record) return null
+  if (error) return <span>-</span>
+  if (!loaded) return <span>…</span>
+  return <span>{counts[record.tagValue] || 0}</span>
+}
+
+// Right-aligned like the NumberField it replaces; Datagrid reads this off
+// the child's props.
+AlbumCountField.defaultProps = { textAlign: 'right' }
+
+// Reads the `tag` resource rather than a `neighbour` one: there is no
+// /api/neighbour, and none is needed -- a neighbour is just a value of the
+// `neighbour` tag. Narrowing by tag_name is how AlbumFilter reads its own
+// recordlabel and grouping values.
+const NeighbourList = (props) => {
+  const { counts, loaded, error } = useNeighbourCounts()
+
+  return (
+    <List
+      {...props}
+      resource="tag"
+      basePath="/neighbour"
+      filter={{ tag_name: 'neighbour' }}
+      filters={null}
+      exporter={false}
+      bulkActionButtons={false}
+      sort={{ field: 'name', order: 'ASC' }}
+      perPage={200}
+      pagination={null}
+    >
+      <Datagrid>
+        <NeighbourNameField
+          source="tagValue"
+          label="resources.neighbour.fields.name"
+        />
+        <AlbumCountField
+          source="albumCount"
+          label="resources.neighbour.fields.albumCount"
+          counts={counts}
+          loaded={loaded}
+          error={error}
+        />
+      </Datagrid>
+    </List>
+  )
+}
+
+export default NeighbourList

diff --color -ruN '--exclude=.git' a/ui/src/neighbour/NeighbourList.jsx b/ui/src/neighbour/NeighbourList.jsx
--- a/ui/src/neighbour/NeighbourList.jsx	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/src/neighbour/NeighbourList.jsx	2026-09-08 11:34:09.062690048 -0700
@@ -0,0 +1,71 @@
+import React from 'react'
+import { Datagrid, List, NumberField } from 'react-admin'
+import { Link } from 'react-router-dom'
+import { withWidth } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useAlbumsPerPage } from '../common'
+
+const useStyles = makeStyles({
+  link: { textDecoration: 'none', color: 'inherit' },
+})
+
+// Filters on the tag VALUE, not the tag id. Album.SetTags stores
+// GroupByFrequency's output in the album's `tags` column, and that maps each
+// tag name to its values -- so despite its name, tagIDFilter compares against
+// "David L", and a tag id would never match.
+//
+// The filter is embedded as raw JSON, exactly as AlbumDetails does for genre
+// chips. Running it through encodeURIComponent first is what broke this:
+// react-router encodes the target as well, so the colon arrived as %253A and
+// the filter was not valid JSON. JSON.stringify is used only for the value,
+// so a name containing a quote cannot break out of the string.
+const useAlbumsOfNeighbour = (width) => {
+  const [perPage] = useAlbumsPerPage(width)
+
+  return (record) =>
+    `/album?filter={"neighbour"=${JSON.stringify([record.tagValue])}}` +
+    `&order=ASC&sort=name&perPage=${perPage}`
+}
+
+const NeighbourNameField = withWidth()(({ width, record }) => {
+  const classes = useStyles()
+  const albumsOf = useAlbumsOfNeighbour(width)
+  if (!record) return null
+  return (
+    <Link to={albumsOf(record)} className={classes.link}>
+      {record.tagValue}
+    </Link>
+  )
+})
+
+// Reads the `tag` resource rather than a `neighbour` one: there is no
+// /api/neighbour, and none is needed -- a neighbour is just a value of the
+// `neighbour` tag. Narrowing by tag_name is how AlbumFilter reads its own
+// recordlabel and grouping values.
+const NeighbourList = (props) => (
+  <List
+    {...props}
+    resource="tag"
+    basePath="/neighbour"
+    filter={{ tag_name: 'neighbour' }}
+    filters={null}
+    exporter={false}
+    bulkActionButtons={false}
+    sort={{ field: 'name', order: 'ASC' }}
+    perPage={200}
+    pagination={null}
+  >
+    <Datagrid>
+      <NeighbourNameField
+        source="tagValue"
+        label="resources.neighbour.fields.name"
+      />
+      <NumberField
+        source="albumCount"
+        label="resources.neighbour.fields.albumCount"
+      />
+    </Datagrid>
+  </List>
+)
+
+export default NeighbourList

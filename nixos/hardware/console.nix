# Originally generated by `nixos-generate-config`, now maintained by hand.
# Hardware-detected facts only (disks, kernel modules, microcode); anything
# you'd choose rather than detect belongs in ../hosts/console.nix.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  # "nvme" is carried over from the generated scan; this box has no NVMe slot
  # populated today (one SATA disk, sda) so it is inert. Harmless to keep, and
  # it means a later M.2 drive is bootable without touching the initrd.
  boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "ahci" "usbhid" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  # Single 120G KINGSTON SV300S37A120G: 512M ESP + the rest as one ext4 root.
  # No separate /nix or /home here, unlike suspense.
  fileSystems."/" =
    { device = "/dev/disk/by-uuid/ed5809e8-7e6e-43b0-9fda-94a547795d75";
      fsType = "ext4";
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/286B-A239";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  # No swap partition and no swapfile. With a 512M ESP on a 120G disk there is
  # not much room to spare, and this box streams games rather than building
  # them -- the link-time memory spikes that justify swap on suspense do not
  # happen here.
  swapDevices = [ ];

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp3s0.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp2s0.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
